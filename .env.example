# ============================================
# PUZZROO — Environment Variables (example)
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/puzzroo

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# --- Firebase Client (public, used in browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# --- JWT ---
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# --- Token Lifetimes ---
# Access token: short-lived (15-30m recommended for security; default 7d in code)
# Refresh token: long-lived (default 7d)
ACCESS_TOKEN_EXPIRES=15m
# REFRESH_TOKEN_EXPIRES=7d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret

# --- Resend (transactional email — preferred, fast delivery) ---
# Get a key at https://resend.com/api-keys. `RESEND_FROM` must be a verified
# domain (add Resend's SPF/TXT + DKIM CNAME records to your DNS) — until then
# `onboarding@resend.dev` only delivers to the Resend account owner's email.
RESEND_API_KEY=re_your-api-key
RESEND_FROM=Puzzroo <noreply@your-domain.com>

# --- SMTP (fallback if RESEND is not configured) ---
# Only used when RESEND_API_KEY is absent. Delivery via personal Gmail SMTP is
# slow (1+ min relays), spam-prone, and capped (~500/day) — prefer Resend.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# --- Session ---
SESSION_COOKIE_SECRET=your-session-secret-min-32-chars

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Location (best-effort geolocation) ---
# Reverse geocoding: OpenStreetMap Nominatim (free). Optional email identifies
# your app to OSM's fair-use policy. Override the endpoint for a self-hosted
# Nominatim instance.
# NOMINATIM_EMAIL=you@example.com
# NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# IP intelligence: optional 4th provider for IP->location (free tier).
# Lookup order: ipwho.is -> ip-api.com -> ipapi.co -> ipinfo (token).
# IPINFOIO_TOKEN=your-ipinfo-token
# Diagnostics: echo received client-IP headers in the `x-puzzroo-debug`
# response header (GET /api/v1/location) to debug proxy setups.
# LOCATION_DEBUG=1
